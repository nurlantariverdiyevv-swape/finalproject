# Firebase konsolundan (Project settings > General > Your apps) kopyaladığınız
# konfiqurasiya dəyərlərini bu fayla deyil, "/.env" adlı yeni fayla yazın
# (bu fayl yalnız nümunədir və commit-lənə bilər, .env isə gizli saxlanmalıdır).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
